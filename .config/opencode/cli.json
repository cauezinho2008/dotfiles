{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "vercel",
    "mode": "system"
  },
  "diffs": {
    "wrap": "word",
    "view": "auto"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "hide",
    "markdown": "source",
    "grouping": "auto",
    "image_preview": true,
    "permissions": "prompt",
    "tps": true,
    "new_location": "launch"
  },
  "animations": true,
  "tabs": {
    "enabled": true,
    "layout": "horizontal",
    "indicators": "status",
    "scope": "cwd"
  },
  "prompt": {
    "image_preview": true
  },
  "debug": {
    "devtools": false
  }
}
